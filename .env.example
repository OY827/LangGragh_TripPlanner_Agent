# LLM
OPENAI_API_KEY=your_openai_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-turbo

# 高德地图（景点坐标 / 天气 / 路线；不要指望它给酒店报价）
AMAP_MAPS_API_KEY=your_amap_key
# Streamable HTTP MCP。默认官方托管 https://mcp.amap.com/mcp?key={AMAP_MAPS_API_KEY}
# 本地 sugarforever/amap-mcp-server 示例：AMAP_MCP_URL=http://localhost:8001/mcp（不要占 FastAPI 的 8000）
AMAP_MCP_URL=
ENABLE_MCP_TOOLS=false
USE_MCP=false

# RollingGo 酒店 MCP（https://mcp.rollinggo.cn/mcp ，Streamable HTTP）
HOTEL_MCP_URL=https://mcp.rollinggo.cn/mcp
HOTEL_API_KEY=your_rollinggo_mcp_key

# 向量库（默认本地 Chroma；设为 qdrant 可切回云/本地 Qdrant）
VECTOR_BACKEND=chroma
CHROMA_PATH=app/data/chroma
CHROMA_COLLECTION=travel_knowledge
CHROMA_GUIDE_COLLECTION=travel_guides
CHROMA_EMBEDDING_BACKEND=dashscope
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=travel_knowledge
EMBEDDING_BACKEND=dashscope
EMBEDDING_MODEL=text-embedding-v1

# Redis：对话会话 / 计划版本（连不上则 VersionManager 自动回退本地文件）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 用户长期记忆（偏好、去过的景点）默认本地 Chroma；file 仅用于无 embedding 的测试
USER_MEMORY_BACKEND=chroma
CHROMA_USER_COLLECTION=user_memory
# 对话上下文滑动窗口：条数由代码 window_size 控制，可选再加 token 上限
# DIALOG_CONTEXT_MAX_TOKENS=2000

# Neo4j 图数据（可选，非 Web 主路径）
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# LangSmith 链路追踪（可选）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=travel-planner
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_TAGS=travel-planner,dev
# LANGSMITH_SAMPLE_RATE=1.0
